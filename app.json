{
  "expo": {
    "name": "Dynamic QR Code Generator",
    "slug": "dynamic-qr-code-generator",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/dynamic-qr-code-generator-app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "qr-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kenwu565657.dynamicqrcodegenerator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/dynamic-qr-code-generator-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kenwu565657.dynamicqrcodegenerator",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "qr-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/dynamic-qr-code-generator-app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ca61bb8a-dbd2-4174-9fd0-f2d0cdb468eb"
      }
    }
  }
}
