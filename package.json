{
  "name": "dynamic-qr-code-generator",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.8",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "js-base64": "^3.7.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
      "preset": "jest-expo",
      "collectCoverageFrom": [
        "App.tsx",
        "components/**/*.{ts,tsx}",
        "app-helpers.ts",
        "qr-code-utils.ts",
        "!**/*.test.{ts,tsx}",
        "!index.ts"
      ],
      "coverageReporters": [
        "text",
        "lcov"
      ]
  },
  "private": true
}
